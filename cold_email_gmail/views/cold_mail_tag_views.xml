<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cold_mail_tag_view_list" model="ir.ui.view">
        <field name="name">cold.mail.tag.list</field>
        <field name="model">cold.mail.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="cold_mail_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">cold.mail.tag</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
