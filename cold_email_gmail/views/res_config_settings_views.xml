<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.cold.email</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Cold Email" string="Cold Email" name="cold_email_gmail"
                     groups="cold_email_gmail.group_cold_email_manager">
                    <block title="Gmail API Credentials"
                           help="From a Google Cloud project with the Gmail API enabled and an OAuth client of type 'Web application'.">
                        <setting id="cold_email_gmail_credentials" string="OAuth Client">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="cold_email_gmail_client_id" string="Client ID"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="cold_email_gmail_client_id"/>
                                </div>
                                <div class="row">
                                    <label for="cold_email_gmail_client_secret" string="Client Secret"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="cold_email_gmail_client_secret" password="True"/>
                                </div>
                                <div class="row mt16">
                                    <label for="cold_email_redirect_uri" string="Redirect URI"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="cold_email_redirect_uri" readonly="1"/>
                                </div>
                                <div class="text-muted mt8">
                                    Add that redirect URI to the OAuth client in the Google Cloud
                                    console, exactly as shown. The scopes requested are
                                    <code>gmail.send</code> and <code>gmail.readonly</code>.
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
