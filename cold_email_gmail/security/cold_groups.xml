<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_cold_email" model="ir.module.category">
            <field name="name">Cold Email</field>
            <field name="description">Cold outreach campaigns sent through the Gmail API.</field>
            <field name="sequence">20</field>
        </record>

        <record id="res_groups_privilege_cold_email" model="res.groups.privilege">
            <field name="name">Cold Email</field>
            <field name="description">Access level for cold outreach campaigns.</field>
            <field name="category_id" ref="module_category_cold_email"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_cold_email_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_cold_email"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Connect a personal Gmail mailbox and run your own campaigns.</field>
        </record>

        <record id="group_cold_email_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_cold_email"/>
            <field name="implied_ids" eval="[(4, ref('cold_email_gmail.group_cold_email_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">See and manage every mailbox and campaign in the company.</field>
        </record>

    </data>
</odoo>
