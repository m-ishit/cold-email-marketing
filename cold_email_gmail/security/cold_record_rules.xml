<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- A rep sees only their own mailbox; a manager sees the company's. -->
        <record id="cold_mailbox_rule_user" model="ir.rule">
            <field name="name">Cold mailbox: own only</field>
            <field name="model_id" ref="model_cold_mailbox"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cold_email_user'))]"/>
        </record>

        <record id="cold_mailbox_rule_manager" model="ir.rule">
            <field name="name">Cold mailbox: company wide</field>
            <field name="model_id" ref="model_cold_mailbox"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_cold_email_manager'))]"/>
        </record>

        <!-- A rep sees only the emails they scheduled; a manager sees the company's. -->
        <record id="cold_mail_rule_user" model="ir.rule">
            <field name="name">Cold email: own only</field>
            <field name="model_id" ref="model_cold_mail"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cold_email_user'))]"/>
        </record>

        <record id="cold_mail_rule_manager" model="ir.rule">
            <field name="name">Cold email: company wide</field>
            <field name="model_id" ref="model_cold_mail"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_cold_email_manager'))]"/>
        </record>

    </data>
</odoo>
